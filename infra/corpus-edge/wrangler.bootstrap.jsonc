{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foxue-ai-corpus-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "canon.foxue.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "RELEASE_ID": "gbcr-6.20.0-2b8ab8d5e4fe-eac6c24781dd-a582cf471b7c-9477bb40e47f",
    "RELEASE_MANIFEST_SHA256": "00c80c013e6069f4aebbbf9f7167d691dfef3ff6060ad55489d3ffb2d3c0ecc0",
    "ORIGIN_COVERAGE_URL": "https://www.foxue.ai/api/v1/corpus/coverage"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
