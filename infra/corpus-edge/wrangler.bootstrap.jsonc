{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foxue-ai-corpus-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "canon.foxue.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "RELEASE_ID": "gbcr-6.19.0-2b8ab8d5e4fe-eac6c24781dd-a582cf471b7c-4cb4dfeb67de",
    "RELEASE_MANIFEST_SHA256": "64bbba7592dcd4339837778a899b955c63039b2fa3479395b37b92501a27437d",
    "ORIGIN_COVERAGE_URL": "https://www.foxue.ai/api/v1/corpus/coverage"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
