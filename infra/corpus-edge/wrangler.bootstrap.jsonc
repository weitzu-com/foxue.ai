{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foxue-ai-corpus-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "canon.foxue.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "RELEASE_ID": "gbcr-6.18.0-2b8ab8d5e4fe-eac6c24781dd-a582cf471b7c-045bebe5bf12",
    "RELEASE_MANIFEST_SHA256": "8bc1fd81a26174c8342954d6761d7aa82948708d1e83e8357ea7ef348c7cbea4",
    "ORIGIN_COVERAGE_URL": "https://foxue.ai/api/v1/corpus/coverage"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
