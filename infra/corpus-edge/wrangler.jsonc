{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foxue-ai-corpus-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "canon.foxue.ai",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CORPUS",
      "bucket_name": "foxue-ai-corpus"
    }
  ],
  "vars": {
    "RELEASE_ID": "gbcr-6.21.0-2b8ab8d5e4fe-eac6c24781dd-a582cf471b7c-7e66cd1d914d",
    "RELEASE_MANIFEST_SHA256": "cfbdfb24112867a4a8d0cbd66c5cb7984f1b6ed9bc646f4037da0a07ac85d517",
    "ORIGIN_COVERAGE_URL": "https://www.foxue.ai/api/v1/corpus/coverage"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
