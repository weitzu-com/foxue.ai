{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foxue-ai-corpus-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "canon.foxue.ai",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CORPUS",
      "bucket_name": "foxue-ai-corpus"
    }
  ],
  "vars": {
    "RELEASE_ID": "gbcr-6.22.0-2b8ab8d5e4fe-eac6c24781dd-a582cf471b7c-840e6e027cd8",
    "RELEASE_MANIFEST_SHA256": "8be67c42b53586a51b8dcda8e4d7ef23ae21581ce0e0c3b3e80d4f6e01e00290",
    "ORIGIN_COVERAGE_URL": "https://www.foxue.ai/api/v1/corpus/coverage"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
