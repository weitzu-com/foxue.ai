{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "foxue-ai-corpus-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "canon.foxue.ai",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CORPUS",
      "bucket_name": "foxue-ai-corpus"
    }
  ],
  "vars": {
    "RELEASE_ID": "__SET_BY_CORPUS_RELEASE_WORKFLOW__",
    "RELEASE_MANIFEST_SHA256": "__SET_BY_CORPUS_RELEASE_WORKFLOW__",
    "ORIGIN_COVERAGE_URL": "https://www.foxue.ai/api/v1/corpus/coverage"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
