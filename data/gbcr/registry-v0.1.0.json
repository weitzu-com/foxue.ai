  "claimPolicy": {
    "target": "99%",
    "publishable": false,
    "reason": "全球分母尚未完成跨传统、跨语种和独立评审，因此不得发布总体覆盖百分比。",
    "rule": "目录、完整原文、稳定段落、译文、权利和质量必须分别计算；未知分母不得以零代替，也不得合并成单一营销数字。",
    "reviewGate": "只有在分母定义公开、来源快照冻结、重复项规则可复算，并经至少两个独立机构或专家组复核后，才可发布全球百分比。"
  },
  "dimensions": [
    { "id": "catalog", "label": "目录覆盖", "definition": "已建立规范作品标识，并记录至少一个可核验的外部目录标识。" },
    { "id": "full_source_text", "label": "完整原文", "definition": "完整表达版本已合法取得、格式化并通过结构校验；摘录不计入。" },
    { "id": "stable_segments", "label": "稳定段落", "definition": "可公开访问的文本片段具有持久标识，旧链接可解析。" },
    { "id": "translation", "label": "译文覆盖", "definition": "按目标语言分别统计完整译文；机器候选与人工确认分开。" },
    { "id": "rights", "label": "权利可发布", "definition": "已逐对象记录许可、地域、用途、署名与再分发限制。" },
    { "id": "quality", "label": "质量通过", "definition": "来源、结构、段落和抽样文本通过人工或独立质量门。" }
  ],
