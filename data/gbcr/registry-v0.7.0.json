    {
      "id": "full_source_text",
      "label": "完整原文",
      "definition": "完整表达版本已合法取得、格式化并通过结构校验；摘录不计入。"
    },
    {
      "id": "stable_segments",
      "label": "稳定段落",
      "definition": "可公开访问的文本片段具有持久标识，旧链接可解析。"
    },
    {
      "id": "translation",
      "label": "译文覆盖",
      "definition": "按目标语言分别统计完整译文；机器候选与人工确认分开。"
    },
    {
      "id": "rights",
      "label": "权利可发布",
      "definition": "已逐对象记录许可、地域、用途、署名与再分发限制。"
    },
    {
      "id": "quality",
      "label": "质量通过",
      "definition": "来源、结构、段落和抽样文本通过人工或独立质量门。"
    }
  ],
