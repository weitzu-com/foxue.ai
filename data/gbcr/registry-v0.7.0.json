  "claimPolicy": {
    "target": "99%",
    "publishable": false,
    "reason": "全球分母尚未完成跨传统、跨语种和独立评审，因此不得发布总体覆盖百分比。",
    "rule": "目录、完整原文、稳定段落、译文、权利和质量必须分别计算；未知分母不得以零代替，也不得合并成单一营销数字。",
    "reviewGate": "只有在分母定义公开、来源快照冻结、重复项规则可复算，并经至少两个独立机构或专家组复核后，才可发布全球百分比。"
  },
