# 网站公开地址。预览环境可留空，生产环境设为 https://foxue.ai
NEXT_PUBLIC_SITE_URL=https://foxue.ai

# 经典对象边缘源；启用 Cloudflare R2 后设为 https://canon.foxue.ai。
# 未设置或边缘读取失败时，服务端自动回退到仓库内经核验的受控原文。
# CORPUS_ASSET_BASE_URL=https://canon.foxue.ai

# GA4 网页数据流的衡量 ID。只在访客明确同意匿名统计后加载。
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 可选：GSC 网址前缀资源的 HTML 验证值。网域资源优先使用 Cloudflare DNS TXT 验证。
# GOOGLE_SITE_VERIFICATION=

# 后续接入模型网关时使用；首版不依赖任何模型密钥。
# AI_GATEWAY_API_KEY=

# ── 每日 SEO 博客（scripts/blog-daily.mjs + .cursor/skills/blog-daily，见 docs/BLOGS.md）──
# 文章与配图由 Cursor Agent 完成，不需要任何模型密钥。以下只影响选题数据与署名。

# Google 服务账号 JSON（整段 JSON 字符串，或其 base64 编码），需在 Search Console 中把该账号
# 加为 sc-domain:foxue.ai 的用户（受限权限即可）。缺失时流水线回落到 content/blogs/seed-keywords.json。
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_SITE_URL=sc-domain:foxue.ai

# 文章署名，默认 leizi / foxue.ai 编辑；finalize 要求至少 BLOG_MIN_VERIFIED_QUOTES 条逐字核对通过的引文。
# BLOG_AUTHOR_NAME=leizi
# BLOG_AUTHOR_ROLE=foxue.ai 编辑
# BLOG_MIN_VERIFIED_QUOTES=2
