{
  "name": "foxue-ai",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build:cbeta-catalog": "node scripts/build-cbeta-catalog.mjs",
    "verify:cbeta-catalog": "node scripts/build-cbeta-catalog.mjs --verify",
    "import:cbeta": "node scripts/import-cbeta-source.mjs",
    "build:suttacentral-catalog": "node scripts/build-suttacentral-catalog.mjs",
    "verify:suttacentral-catalog": "node scripts/build-suttacentral-catalog.mjs --verify",
    "import:suttacentral": "node scripts/import-suttacentral-source.mjs",
    "build:suttacentral-dn-catalog": "node scripts/build-suttacentral-dn-catalog.mjs",
    "verify:suttacentral-dn-catalog": "node scripts/build-suttacentral-dn-catalog.mjs --verify",
    "import:suttacentral:dn": "node scripts/import-suttacentral-dn-source.mjs",
    "audit:suttacentral:collection": "node scripts/audit-suttacentral-collection.mjs",
    "build:suttacentral-mn-catalog": "node scripts/build-suttacentral-mn-catalog.mjs",
    "verify:suttacentral-mn-catalog": "node scripts/build-suttacentral-mn-catalog.mjs --verify",
    "import:suttacentral:mn": "node scripts/import-suttacentral-mn-source.mjs",
    "snapshot:upstream": "node scripts/snapshot-upstream-catalogs.mjs --write",
    "verify:upstream-snapshots": "node scripts/snapshot-upstream-catalogs.mjs --verify",
    "verify:corpus": "node scripts/verify-corpus-registry.mjs",
    "verify:cbeta-pilot": "node scripts/verify-cbeta-pilot.mjs",
    "build:corpus-catalog": "node scripts/build-corpus-catalog.mjs && node scripts/build-suttacentral-catalog.mjs && node scripts/build-suttacentral-dn-catalog.mjs && node scripts/build-suttacentral-mn-catalog.mjs && node scripts/build-federated-corpus.mjs",
    "verify:corpus-catalog": "node scripts/build-corpus-catalog.mjs --verify && node scripts/build-suttacentral-catalog.mjs --verify && node scripts/build-suttacentral-dn-catalog.mjs --verify && node scripts/build-suttacentral-mn-catalog.mjs --verify && node scripts/build-federated-corpus.mjs --verify",
    "build:corpus-release": "node scripts/build-corpus-release.mjs",
    "verify:corpus-release": "node scripts/verify-corpus-release.mjs",
    "publish:corpus:r2": "node scripts/publish-corpus-release.mjs",
    "cloudflare:types": "wrangler types infra/corpus-edge/worker-configuration.d.ts --config infra/corpus-edge/wrangler.jsonc",
    "cloudflare:types:check": "wrangler types infra/corpus-edge/worker-configuration.d.ts --config infra/corpus-edge/wrangler.jsonc --check",
    "cloudflare:check": "wrangler deploy --config infra/corpus-edge/wrangler.jsonc --dry-run --outdir artifacts/worker-dry-run",
    "preserve": "node scripts/build-preservation-bundle.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm verify:cbeta-catalog && pnpm verify:corpus-catalog && pnpm verify:corpus && pnpm verify:cbeta-pilot && pnpm build:corpus-release && pnpm verify:corpus-release && pnpm cloudflare:types:check && pnpm cloudflare:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.120.1"
  }
}
